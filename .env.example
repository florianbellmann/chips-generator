BASE_URL='https://website.com'

# CDP endpoint of the remote headless Chromium this script drives. Must be a
# reachable host:port, not a reverse-proxied name.
BROWSER_ENDPOINT='http://192.168.178.161:3000'

ACCOUNTS='[{"label":"account-1","username":"username-1","password":"password-1"},{"label":"account-2","username":"username-2","password":"password-2"}]'
# Optional. A random delay is applied between accounts, not before the first one.
MIN_DELAY_MS=1000
MAX_DELAY_MS=300000

# For one account, omit ACCOUNTS and use these legacy values instead.
# USERNAME='username'
# PASSWORD='password'
